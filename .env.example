# PulseGate environment for running services on the host (npm run dev:*).
# Docker Compose uses its own development defaults; copy this to .env to override them.
# Generate real secrets with:  node scripts/generate-secrets.mjs

NODE_ENV=development
LOG_LEVEL=info

# --- Infrastructure (docker compose up -d postgres redis) ---
DATABASE_URL=postgres://pulsegate:pulsegate@localhost:55432/pulsegate
REDIS_URL=redis://localhost:56379

# --- Secrets (DEVELOPMENT VALUES; services reject these when NODE_ENV=production) ---
# HMAC pepper for client API key hashes. Rotating it invalidates every issued key.
API_KEY_PEPPER=dev-only-pepper-change-me-in-production
# AES-256-GCM keyring "<id>:<base64 32 bytes>[,<id>:<key>]". First key encrypts; all keys decrypt.
ENCRYPTION_KEYS=dev:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# --- Upstream SSRF policy ---
# Development only: permit private/loopback upstreams (e.g. the local demo upstream). Refused in production.
ALLOW_PRIVATE_UPSTREAMS=true
# UPSTREAM_REQUIRE_HTTPS=false          # defaults to true in production
# UPSTREAM_ALLOWED_PORTS=443,8443        # empty = any port

# --- API (control plane) ---
API_PORT=4000
GATEWAY_PUBLIC_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false                    # forced true in production
# SESSION_TTL_HOURS=168
# SESSION_IDLE_HOURS=24
# REGISTRATION_ENABLED=true
# MGMT_RATE_LIMIT_REQUESTS=600
# MGMT_RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_EMAIL=10

# --- Gateway (data plane) ---
GATEWAY_PORT=8787
GATEWAY_ADMIN_PORT=9464
# GATEWAY_MAX_REQUEST_BODY_BYTES=10485760
# GATEWAY_MAX_RESPONSE_BODY_BYTES=52428800
# GATEWAY_MAX_CONCURRENCY=2000
# GATEWAY_MAX_UPSTREAM_TIMEOUT_MS=120000
# GATEWAY_CONFIG_CACHE_TTL_MS=5000
# GATEWAY_CONFIG_STALE_MAX_MS=60000
# RATE_LIMIT_FAILURE_MODE=closed         # closed (503) | open (bypass, logged)
# GATEWAY_ACCESS_LOG=false
# TRUST_PROXY=false

# --- Analytics / worker ---
# ANALYTICS_FLUSH_INTERVAL_MS=250
# ANALYTICS_MAX_BUFFER=50000
# ANALYTICS_STREAM_MAXLEN=1000000
RETENTION_DAYS=30

# --- Demo / seed ---
DEMO_UPSTREAM_URL=http://localhost:4100
# DEMO_USER_PASSWORD=pulsegate-demo-123
