{
  "name": "@pulsegate/gateway",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker/main.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern test/unit"
  },
  "dependencies": {
    "@pulsegate/db": "0.1.0",
    "@pulsegate/shared": "0.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.0",
    "pino": "^9.14.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@pulsegate/demo-upstream": "0.1.0",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.23.15"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@pulsegate/shared$": "<rootDir>/../../packages/shared/src",
      "^@pulsegate/db$": "<rootDir>/../../packages/db/src",
      "^@pulsegate/demo-upstream$": "<rootDir>/../demo-upstream/src/app"
    },
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "globalSetup": "<rootDir>/../api/test/global-setup.js"
  }
}
